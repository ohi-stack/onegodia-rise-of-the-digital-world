# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key for server-side Stripe payments (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# STRIPE_PUBLISHABLE_KEY / VITE_STRIPE_PUBLISHABLE_KEY: Client-side publishable key for Stripe checkout (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# ACC_API_KEY & ACC_API_URL: Cloud Gateway & ACC API integration
ACC_API_KEY=
ACC_API_URL=

# ANTHROPIC_API_KEY: Anthropic Claude API Key for Narrative & Agent Intelligence
ANTHROPIC_API_KEY=

# DATABASE_URL: PostgreSQL / Relational Database Connection URL (e.g., postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# OBP_NODE_URL: Onegodia Blockchain / Node Protocol URL
OBP_NODE_URL=

# OPENAI_API_KEY: OpenAI API Key for Multi-Agent Simulation (GPT-4o)
OPENAI_API_KEY=

# QRV_VERIFY_URL: QRV Quantum Receipt & Asset Verification Node Endpoint
QRV_VERIFY_URL=

# XAI_API_KEY: xAI API Key (Grok) for Cybernetic Tactical Analysis
XAI_API_KEY=
